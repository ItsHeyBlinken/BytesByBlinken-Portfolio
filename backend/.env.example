# Copy to .env and fill in real values. Never commit .env to git.
NODE_ENV=production
PORT=3000

DB_HOST=your-vps-host
DB_PORT=5432
DB_NAME=portfolio_blog
DB_USER=your-db-user
DB_PASSWORD=CHANGE_ME
DB_SSL_MODE=disable
# Production: set DB_SSL_MODE=require and configure PostgreSQL SSL.

DATABASE_URL=postgres://your-db-user:CHANGE_ME@your-vps-host:5432/portfolio_blog

# Required. The server will not start without these.
# JWT_SECRET: a long random value, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Placeholder values like the one below are rejected at startup.
JWT_SECRET=changeme-jwt-secret-min-32-chars-long-here
# ADMIN_PASSWORD_HASH: a bcrypt hash of the admin password, for example the output of:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your-password'
# In a .env file, wrap the hash in single quotes so the $ characters are kept as-is.
ADMIN_PASSWORD_HASH=CHANGE_ME_bcrypt_hash_from_bcryptjs

# Optional. Defaults to "admin".
ADMIN_USERNAME=admin

CORS_ORIGIN=https://your-domain.example
